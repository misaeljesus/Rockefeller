# Claves API de Binance (Spot). Recomendado: restringir por IP y
# deshabilitar retiros en los permisos de la clave.
BINANCE_API_KEY=tu_api_key
BINANCE_API_SECRET=tu_api_secret

# Modo de operación: paper | testnet | live
# Vive aquí (y no en config.py) para que `git pull` NUNCA revierta
# el servidor de producción a modo simulación por accidente.
ROCKEFELLER_MODE=paper

# Tope de capital que el bot puede usar (USDT)
ROCKEFELLER_CAPITAL_USDT=20
